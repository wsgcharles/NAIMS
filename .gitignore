# ─── EduCore / NAISIS — Root .gitignore ──────────────────────────────────────
# This file protects the repository root.
# Additional per-directory rules are in backend/.gitignore and frontend/.gitignore.

# ─── Secrets & Local Configuration ───────────────────────────────────────────
# NEVER commit real credentials. Use environment variables for production.
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.json

# ─── Database Backups & Dumps ─────────────────────────────────────────────────
# Local database backups contain real user data and must never be committed.
*.sql
*.dump
*.backup
*.pg_dump
!**/Migrations/*.cs
!**/Migrations/*.Designer.cs

# ─── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vs/
.idea/
*.user
*.suo
*.code-workspace
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*

# ─── Build Artifacts (handled per-directory too) ─────────────────────────────
node_modules/
dist/
dist-ssr/
bin/
obj/
out/
publish/
