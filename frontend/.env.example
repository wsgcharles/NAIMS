# EduCore Frontend Environment Variables Template
# Copy this file to .env for local development.
# Set these variables in Vercel Project Settings for cloud production.

# Local Development API Endpoint (Default ASP.NET Core API port):
VITE_API_BASE_URL=http://localhost:5097/api

# Production / Vercel Environment Configuration Example:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
