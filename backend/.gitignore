# ASP.NET Core — SECURITY: appsettings files contain secrets (SMTP, JWT, DB passwords).
# Never commit appsettings.json or any environment-specific appsettings to source control.
# Use environment variables or a secrets manager in production.
# Use `dotnet user-secrets` in development.
#
# EXCEPTION: appsettings.Production.json IS intentionally tracked because it contains
# only safe placeholders and non-secret configuration. All real secrets are injected
# via the cloud host's environment variable system (Render/Railway/Azure).
appsettings.json
appsettings.Development.json

