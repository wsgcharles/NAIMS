{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Port=5432;Database=educore_db;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },

  "Jwt": {
    "Key": "REPLACE_WITH_MINIMUM_32_CHARACTER_RANDOM_SECRET",
    "Issuer": "EduCoreAPI",
    "Audience": "EduCoreClient",
    "DurationInMinutes": 480
  },

  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_GMAIL_ADDRESS@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD_HERE",
    "SenderEmail": "YOUR_GMAIL_ADDRESS@gmail.com",
    "SenderName": "Noah's Academy",
    "EnableSsl": true,
    "ReplyToAddress": ""
  },

  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:5173",
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EduCore.API.Services.EmailService": "Debug",
      "EduCore.API.Services.EmailBackgroundWorker": "Debug"
    }
  },

  "AllowedHosts": "*"
}
